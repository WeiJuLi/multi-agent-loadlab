# Mock LLM

MOCK_LLM_SEED=42

# Mock LLM Latency 模擬延遲，單位毫秒
# 延遲 = (固定開銷 + prompt_tokens × 每 prompt token 時間 + completion_tokens × 每 completion token 時間) × 隨機抖動
# Latency = (Base Latency + prompt_tokens × per prompt token time + completion_tokens × per completion token time) × random jitter
# 固定開銷：網路來回、排隊；和 prompt 長度無關
MOCK_LLM_LATENCY_BASE_MS=200
# 讀 prompt（prefill）：模型可以平行讀整段 prompt，所以每 token 很便宜
MOCK_LLM_LATENCY_PER_PROMPT_TOKEN_MS=0.3
# 生成回答（decode）：一次只能吐一個 token，所以每 token 比較貴
MOCK_LLM_LATENCY_PER_COMPLETION_TOKEN_MS=15
# 0.2 代表實際延遲在計算值的 80%~120% 之間隨機
MOCK_LLM_LATENCY_JITTER=0.2

# 限流
MOCK_LLM_RATE_LIMIT_ENABLED=true
# 每分鐘最多幾個請求；0 代表不限
MOCK_LLM_RPM=1000
# 每分鐘最多幾個 token；0 代表不限
MOCK_LLM_TPM=1000000
# 請求沒帶 max_tokens 時，TPM 用這個值估算
MOCK_LLM_DEFAULT_MAX_TOKENS=800

# 故障注入（階段 5 會大量使用）；預設全關，讓系統正常運作
# 隨機回 500 的機率，0.05 = 5%
MOCK_LLM_ERROR_RATE=0.0
# 隨機「卡住很久」的機率，和每次卡住的秒數
MOCK_LLM_HANG_RATE=0.0
MOCK_LLM_HANG_SECONDS=60
# true = 整個服務暫停回應，模擬下游中斷
MOCK_LLM_PAUSED=false

# Backend 

# LLM 的網址；換成真的 OpenAI 時只改這裡，程式碼不用動
LLM_BASE_URL=http://localhost:8001/v1
# 模擬服務不檢查 key，隨便填即可；真的 key 只放在 .env
LLM_API_KEY=mock-key
# 模型名稱；模擬服務只會原樣回傳，換真的 LLM 時才有意義
LLM_MODEL=gpt-4o-mini
# 0 = 回答最穩定，方便重現實驗結果
LLM_TEMPERATURE=0
# 每次回覆最多幾個 token；也會影響模擬服務的 TPM 計算
LLM_MAX_TOKENS=512
# 單次 LLM 呼叫的逾時秒數
LLM_TIMEOUT_SECONDS=30
# SDK 自動重試次數：階段 5 前保持 0，讓錯誤原樣呈現（見 roadmap 第 9 頁「常見坑」）
LLM_MAX_RETRIES=0